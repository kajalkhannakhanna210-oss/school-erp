NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix this with NEXT_PUBLIC_. Used to create student
# (and later, staff) login accounts via the Supabase Auth Admin API.
# Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay — use TEST MODE keys until you've verified the whole flow end to
# end (see the README's "before going live" checklist). key_id is safe to
# expose to the browser (it's what Checkout.js uses); the other two are not.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

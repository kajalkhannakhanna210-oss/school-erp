# Copy this file to .env.local and fill values for local development.
# Do NOT commit real secrets to source control.

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co
# Supabase service role key (keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Puppeteer: path to Chromium/Chrome executable. After running npm run download-chromium, set this to the chrome.exe path.
# Example (Windows): C:\Users\you\projects\school-management\.local-chrome\chrome-win\chrome.exe
PUPPETEER_EXECUTABLE_PATH=
